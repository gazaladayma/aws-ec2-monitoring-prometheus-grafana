global:
  scrape_interval: 15s
  evaluation_interval: 15s
  external_labels:
    environment: production
    region: us-east-1

alerting:
  alertmanagers:
    - static_configs:
        - targets:
            - 'localhost:9093'

rule_files:
  - /etc/prometheus/alert_rules.yml

scrape_configs:
  - job_name: 'prometheus'
    static_configs:
      - targets: ['localhost:9090']

  - job_name: 'alertmanager'
    static_configs:
      - targets: ['localhost:9093']

  - job_name: 'node_exporter'
    scrape_interval: 15s
    scrape_timeout: 10s

    # Keep monitoring the monitoring server itself.
    static_configs:
      - targets: ['localhost:9100']
        labels:
          name: 'java-app-bastion'
          role: 'monitoring'

    # Automatically discover running application instances in the ASG.
    ec2_sd_configs:
      - region: us-east-1
        port: 9100
        filters:
          - name: tag:aws:autoscaling:groupName
            values:
              - java-app-asg
          - name: instance-state-name
            values:
              - running

    # Add useful labels to every discovered application instance.
    relabel_configs:
      - source_labels: [__meta_ec2_instance_id]
        target_label: name
        replacement: 'app-$1'
        regex: '(.+)'
      - source_labels: [__meta_ec2_availability_zone]
        target_label: az
        regex: '(.+)'
      - source_labels: [__meta_ec2_instance_id]
        target_label: role
        replacement: app
        regex: '(.+)'
